# Copy to .env (gitignored) and fill in on each host.

# Generate with `ffm secrets init`. Never commit this.
FFM_MASTER_KEY=

# Safety switch. Leave true until you have watched a few runs.
# Nothing is sent to any platform while this is on.
FFM_DRY_RUN=true

FFM_TIMEZONE=America/New_York
FFM_LOG_LEVEL=INFO

# Low-tier actions (pick'em submits, benching an OUT player) run unattended.
# Money-tier actions (FAAB, survivor, drops, trades) always require approval
# and there is no setting that changes that.
FFM_AUTO_EXECUTE_LOW_TIER=true

# Notifications (optional; set either, both, or neither)
FFM_NTFY_TOPIC=
FFM_DISCORD_WEBHOOK_URL=
